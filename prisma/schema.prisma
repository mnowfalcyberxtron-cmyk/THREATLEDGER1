generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ANALYST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum GroupSource {
  RANSOMWARE_LIVE
  ISMALICIOUS
  RANSOMWATCH
  MANUAL
  MERGED
  MULTI_SOURCE
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED_DISTINCT
  REJECTED_FALSE_POSITIVE
  LINKED_AS_ALIAS
  POSSIBLE_REBRAND
  RESEARCH_REQUESTED
}

enum SourceLineage {
  PRIMARY_INDEPENDENT
  DERIVED_OR_MIRRORED
  HISTORICAL_ARCHIVE
}

enum ObservationSemantic {
  FIRST_CLAIM
  SOURCE_ADDED
  SOURCE_UPDATED
  THREATLEDGER_OBSERVED
  IMPORTED
}

enum GroupStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  RENAMED
}

enum DiscoveryStatus {
  BASELINE
  NEWLY_LISTED
  PREVIOUSLY_KNOWN
  MANUALLY_ADDED
  REAPPEARED
  RENAMED_UNDER_REVIEW
}

enum AssignmentPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  ON_HOLD
  SUBMITTED_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED_COMPLETED
  REJECTED
  REASSIGNED
  CANCELLED
}

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NOT_APPLICABLE
}

enum NoteType {
  SHARED
  ADMIN_PRIVATE
}

enum UploadStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  RATE_LIMITED
}

enum EmailProvider {
  SMTP
  RESEND
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

// ----------------------------------------------------
// IDENTITY & USERS
// ----------------------------------------------------

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  encryptedPassword String?
  supabaseUid       String?      @unique
  status            UserStatus   @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  profile           UserProfile?
  sentInvitations   Invitation[] @relation("InvitedByUser")
  sessions          Session[]

  @@index([email])
}

model UserProfile {
  id               String       @id @default(uuid())
  userId           String       @unique
  fullName         String
  role             UserRole     @default(ANALYST)
  avatarUrl        String?
  timezone         String       @default("Asia/Kolkata")
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks    Assignment[] @relation("PrimaryAnalyst")
  createdTasks     Assignment[] @relation("TaskAssigner")
  reviewedTasks    Assignment[] @relation("TaskReviewer")
  assignmentNotes  AssignmentNote[]
  deadlineChanges  AssignmentDeadlineHistory[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  reportSubmissions ReportSubmission[] @relation("ReportSubmitter")
  groupVerifications GroupVerification[]

  @@index([role])
}

model Invitation {
  id          String           @id @default(uuid())
  email       String
  role        UserRole         @default(ANALYST)
  token       String           @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  invitedBy   User             @relation("InvitedByUser", fields: [invitedById], references: [id])

  @@index([email])
  @@index([token])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
}

// ----------------------------------------------------
// THREAT INTELLIGENCE: RANSOMWARE GROUPS & VICTIMS
// ----------------------------------------------------

model RansomwareGroup {
  id                    String                @id @default(uuid())
  name                  String                @unique
  normalizedName        String                @unique
  description           String?               @db.Text
  source                GroupSource           @default(RANSOMWARE_LIVE)
  externalId            String?
  status                GroupStatus           @default(ACTIVE)
  discoveryStatus       DiscoveryStatus       @default(BASELINE)
  discoveryMonth        String?               // e.g. "2026-11"
  threatLedgerDetectedAt DateTime             @default(now())
  firstObservedAt       DateTime?
  firstClaimAt          DateTime?
  firstClaimSource      String?
  firstSeenSourceAt     DateTime?
  sourceAddedAt         DateTime?
  sourceLastUpdatedAt   DateTime?
  lastObservedAt        DateTime?
  lastSeenAt            DateTime?
  importedAt            DateTime?
  lastVerifiedAt        DateTime?
  verificationStatus    VerificationStatus    @default(UNVERIFIED)
  verificationNotes     String?               @db.Text
  verifiedById          String?
  websiteUrl            String?
  profileUrl            String?
  victimCount           Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  aliases               GroupAlias[]
  snapshots             GroupSnapshot[]
  discoveryEvents       GroupDiscoveryEvent[]
  sourceObservations    GroupSourceObservation[]
  verifications         GroupVerification[]
  victims               Victim[]
  ttps                  GroupTTP[]
  cves                  GroupCVE[]
  tools                 GroupTool[]
  assignments           Assignment[]

  @@index([name])
  @@index([normalizedName])
  @@index([discoveryMonth])
  @@index([discoveryStatus])
  @@index([status])
  @@index([firstObservedAt])
  @@index([firstClaimAt])
  @@index([lastSeenAt])
  @@index([verificationStatus])
}

model GroupAlias {
  id        String          @id @default(uuid())
  groupId   String
  alias     String
  createdAt DateTime        @default(now())

  group     RansomwareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, alias])
  @@index([alias])
}

model GroupSnapshot {
  id               String          @id @default(uuid())
  groupId          String
  snapshotDate     DateTime        @default(now())
  rawSourcePayload Json
  createdAt        DateTime        @default(now())

  group            RansomwareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, snapshotDate])
}

model GroupDiscoveryEvent {
  id             String          @id @default(uuid())
  groupId        String
  discoveryType  DiscoveryStatus
  discoveryMonth String          // YYYY-MM
  detectedAt     DateTime        @default(now())
  details        String?

  group          RansomwareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([discoveryMonth])
}

model Victim {
  id                 String          @id @default(uuid())
  externalId         String?         @unique
  groupId            String
  victimName         String
  country            String?
  countryCode        String?
  sector             String?
  industry           String?
  domain             String?
  discoveredAt       DateTime?
  attackedAt         DateTime?
  sourceUrl          String?
  sourceRetrievedAt  DateTime        @default(now())
  claimType          String          @default("ATTACKER_CLAIM") // ATTACKER_CLAIM vs VERIFIED
  createdAt          DateTime        @default(now())

  group              RansomwareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([victimName])
  @@index([groupId])
  @@index([country])
  @@index([sector])
  @@index([discoveredAt])
}

model GroupTTP {
  id                  String          @id @default(uuid())
  groupId             String
  mitreTactic         String
  mitreTechniqueId    String          // e.g. T1486
  mitreTechniqueName  String
  attckVersion        String          @default("v14.1")
  notes               String?

  group               RansomwareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([mitreTechniqueId])
}

model GroupCVE {
  id              String          @id @default(uuid())
  groupId         String
  cveId           String          // e.g. CVE-2023-34362
  description     String?
  cvssScore       Float?
  exploitedStatus String?

  group           RansomwareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([cveId])
}

model GroupTool {
  id          String          @id @default(uuid())
  groupId     String
  toolName    String
  category    String?         // e.g. "Ransomware Encryptor", "Lateral Movement"
  description String?

  group       RansomwareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// ----------------------------------------------------
// ASSIGNMENT MANAGEMENT & COLLABORATION
// ----------------------------------------------------

model AssignmentBatch {
  id          String       @id @default(uuid())
  title       String
  createdById String
  createdAt   DateTime     @default(now())

  assignments Assignment[]
}

model Assignment {
  id                   String               @id @default(uuid())
  batchId              String?
  groupId              String
  primaryAnalystId     String
  assignerId           String
  reviewerId           String
  title                String
  instructions         String?              @db.Text
  priority             AssignmentPriority   @default(MEDIUM)
  status               AssignmentStatus     @default(ASSIGNED)
  dueDate              DateTime?
  deadlineVersion      Int                  @default(1)
  isLegacyWeekendDeadline Boolean           @default(false)
  acceptedAt           DateTime?
  submittedAt          DateTime?
  submittedById        String?
  reviewedAt           DateTime?
  reviewedById         String?
  approvedAt           DateTime?
  approvedById         String?
  approvedVersionNumber Int?
  rejectionReason      String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  batch                AssignmentBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  group                RansomwareGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  primaryAnalyst       UserProfile          @relation("PrimaryAnalyst", fields: [primaryAnalystId], references: [id])
  assigner             UserProfile          @relation("TaskAssigner", fields: [assignerId], references: [id])
  reviewer             UserProfile          @relation("TaskReviewer", fields: [reviewerId], references: [id])

  checklistItems       AssignmentChecklistItem[]
  notes                AssignmentNote[]
  events               AssignmentEvent[]
  deadlineHistory      AssignmentDeadlineHistory[]
  reminders            AssignmentReminderSchedule[]
  reports              ResearchReport[]
  evidence             SupportingEvidence[]
  reportSubmissions    ReportSubmission[]

  recipientOverrideEmail String?
  recipientOverrideReason String?              @db.Text
  recipientOverrideById String?
  recipientOverrideAt  DateTime?
  ccEmails             String?
  bccEmails            String?

  @@index([groupId])
  @@index([primaryAnalystId])
  @@index([reviewerId])
  @@index([status])
  @@index([dueDate])
}

model AssignmentChecklistItem {
  id                  String          @id @default(uuid())
  assignmentId        String
  itemKey             String          // e.g. "group_overview", "mitre_mapping"
  title               String
  orderIndex          Int
  status              ChecklistStatus @default(NOT_STARTED)
  notApplicableReason String?
  updatedById         String?
  updatedAt           DateTime        @updatedAt

  assignment          Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, orderIndex])
}

model AssignmentNote {
  id           String      @id @default(uuid())
  assignmentId String
  authorId     String
  noteType     NoteType    @default(SHARED)
  content      String      @db.Text
  parentNoteId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignment   Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  author       UserProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([assignmentId, noteType])
}

model AssignmentEvent {
  id           String            @id @default(uuid())
  assignmentId String
  actorId      String
  eventType    String            // "ASSIGNED", "STATUS_CHANGE", "SUBMITTED", "APPROVED", etc.
  oldStatus    AssignmentStatus?
  newStatus    AssignmentStatus?
  reason       String?           @db.Text
  createdAt    DateTime          @default(now())

  assignment   Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
}

model AssignmentDeadlineHistory {
  id           String      @id @default(uuid())
  assignmentId String
  oldDueDate   DateTime?
  newDueDate   DateTime?
  changedById  String
  reason       String?     @db.Text
  createdAt    DateTime    @default(now())

  assignment   Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  changedBy    UserProfile @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([createdAt])
}

model AssignmentReminderSchedule {
  id              String      @id @default(uuid())
  assignmentId    String
  deadlineVersion Int
  reminderType    String      // "TWO_DAYS_BEFORE", "ONE_DAY_BEFORE", "ON_DUE_DATE", "OVERDUE"
  scheduledFor    DateTime
  status          String      @default("PENDING") // "PENDING", "SENT", "CANCELLED", "FAILED"
  sentAt          DateTime?
  errorMessage    String?     @db.Text
  createdAt       DateTime    @default(now())

  assignment      Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, deadlineVersion])
  @@index([scheduledFor, status])
}

// ----------------------------------------------------
// REPORTS & SUPPORTING EVIDENCE (R2 OBJECT METADATA)
// ----------------------------------------------------

model ResearchReport {
  id                    String          @id @default(uuid())
  assignmentId          String
  groupId               String
  latestVersionNumber   Int             @default(1)
  approvedVersionNumber Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  assignment            Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  versions              ReportVersion[]

  @@index([assignmentId])
}

model ReportVersion {
  id               String          @id @default(uuid())
  reportId         String
  versionNumber    Int
  filename         String
  fileSize         Int             // in bytes
  mimeType         String
  r2ObjectKey      String          @unique // e.g. reports/{assignmentId}/{fileId}/{safeFilename}
  sha256           String
  uploaderId       String
  uploadStatus     UploadStatus    @default(PENDING_VERIFICATION)
  submittedAt      DateTime?
  reviewStatus     ReviewStatus    @default(PENDING_REVIEW)
  reviewerComments String?         @db.Text
  createdAt        DateTime        @default(now())

  report           ResearchReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, versionNumber])
  @@index([r2ObjectKey])
}

model SupportingEvidence {
  id           String          @id @default(uuid())
  assignmentId String
  groupId      String
  filename     String
  category     String          // e.g. "Victim Dataset", "Screenshot", "Network Graph", "Raw IOC"
  fileSize     Int
  mimeType     String
  r2ObjectKey  String          @unique // e.g. evidence/{assignmentId}/{fileId}/{safeFilename}
  sha256       String
  description  String?         @db.Text
  uploaderId   String
  uploadStatus UploadStatus    @default(PENDING_VERIFICATION)
  createdAt    DateTime        @default(now())

  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([groupId])
}

model FileDownloadEvent {
  id           String   @id @default(uuid())
  fileType     String   // "REPORT" or "EVIDENCE"
  fileId       String
  userId       String
  ipAddress    String?
  downloadedAt DateTime @default(now())

  @@index([fileId, userId])
}

// ----------------------------------------------------
// NOTIFICATIONS & EMAIL
// ----------------------------------------------------

model Notification {
  id        String      @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String      // "ASSIGNMENT", "SUBMISSION", "REVIEW", "DISCOVERY", "NOTE"
  link      String?
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())

  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model EmailOutbox {
  id                          String        @id @default(uuid())
  recipientEmail              String
  subject                     String
  templateType                String
  provider                    EmailProvider @default(SMTP)
  status                      EmailStatus   @default(PENDING)
  attempts                    Int           @default(0)
  providerMessageId           String?
  errorMessage                String?       @db.Text
  idempotencyKey              String        @unique
  hasAttachment               Boolean       @default(false)
  submissionId                String?
  reportId                    String?
  senderAddress               String?
  lastErrorCode               String?
  lastErrorMessageSanitized   String?       @db.Text
  createdAt                   DateTime      @default(now())
  sentAt                      DateTime?

  @@index([status])
  @@index([idempotencyKey])
}

model EmailConfiguration {
  id                   String   @id @default(uuid())
  senderEmail          String
  senderDisplayName    String   @default("ThreatLedger")
  encryptedAppPassword String
  encryptionIv         String
  encryptionTag        String
  replyToEmail         String?
  archiveBccEmail      String?
  smtpHost             String   @default("smtp.gmail.com")
  smtpPort             Int      @default(465)
  status               String   @default("NOT_CONFIGURED") // NOT_CONFIGURED, CONNECTED, CONNECTION_FAILED, AUTH_EXPIRED
  lastTestedAt         DateTime?
  lastSuccessAt        DateTime?
  lastFailureAt        DateTime?
  lastErrorMessage     String?  @db.Text
  maxAttachmentBytes   Int      @default(18874368) // 18 MB default
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model EmailTemplateConfig {
  id          String   @id @default(uuid())
  templateKey String   @unique
  name        String
  subject     String
  bodyText    String   @db.Text
  bodyHtml    String?  @db.Text
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model ReportSubmission {
  id                      String                 @id @default(uuid())
  assignmentId            String
  versionNumber           Int                    @default(1)
  submittedById           String
  submittedAt             DateTime               @default(now())
  senderEmail             String
  recipientEmail          String
  recipientOverrideActive Boolean                @default(false)
  ccEmails                String?
  bccEmails               String?
  emailSubject            String
  emailMessageId          String?
  providerMessageId       String?
  emailStatus             String                 @default("PENDING") // PENDING, ACCEPTED_BY_GMAIL, FAILED, RETRY_PENDING
  emailAcceptedAt         DateTime?
  cleanupStatus           String                 @default("PENDING") // PENDING, CLEANED, FAILED, RETAINED_ON_FAILURE
  cleanedAt               DateTime?
  cleanupErrorMessage     String?                @db.Text
  totalAttachmentBytes    Int                    @default(0)
  attemptCount            Int                    @default(0)
  lastErrorMessage        String?                @db.Text
  reviewStatus            ReviewStatus           @default(PENDING_REVIEW)
  reviewerComments        String?                @db.Text
  reviewedById            String?
  reviewedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  assignment              Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submittedBy             UserProfile            @relation("ReportSubmitter", fields: [submittedById], references: [id])
  attachments             SubmissionAttachment[]

  @@unique([assignmentId, versionNumber])
  @@index([assignmentId])
  @@index([emailStatus])
  @@index([cleanupStatus])
  @@index([submittedAt])
}

model SubmissionAttachment {
  id              String           @id @default(uuid())
  submissionId    String
  filename        String
  fileSize        Int
  mimeType        String
  sha256          String
  fileCategory    String           // "REPORT" or "EVIDENCE"
  tempStoragePath String?
  isCleanedUp     Boolean          @default(false)
  createdAt       DateTime         @default(now())

  submission      ReportSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// ----------------------------------------------------
// INTEGRATIONS & AUDIT LOGS
// ----------------------------------------------------

model ApiSyncRun {
  id              String     @id @default(uuid())
  syncSource      String     // "RANSOMWARE_LIVE_INVENTORY", "RANSOMWARE_LIVE_VICTIMS", "GITHUB_MONITOR"
  status          SyncStatus @default(RUNNING)
  recordsFetched  Int        @default(0)
  recordsCreated  Int        @default(0)
  recordsUpdated  Int        @default(0)
  newGroupsFound  Int        @default(0)
  errorMessage    String?    @db.Text
  startedAt       DateTime   @default(now())
  completedAt     DateTime?

  @@index([syncSource, startedAt])
}

model GithubRepositoryEvent {
  id              String   @id @default(uuid())
  commitHash      String   @unique
  commitMessage   String
  commitAuthor    String
  committedAt     DateTime
  changedFiles    Json     // Array of changed files and statuses
  createdAt       DateTime @default(now())

  @@index([committedAt])
}

model AuditLog {
  id         String       @id @default(uuid())
  actorId    String?
  actorName  String?
  actorEmail String?
  action     String       // e.g. "USER_LOGIN", "INITIAL_SETUP", "REPORT_SUBMITTED", "REPORT_APPROVED"
  targetType String       // e.g. "ASSIGNMENT", "GROUP", "USER", "SETTING"
  targetId   String?
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  createdAt  DateTime     @default(now())

  actor      UserProfile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SystemSetting {
  id             String   @id @default(uuid())
  key            String   @unique
  valueEncrypted String   @db.Text
  description    String?
  updatedAt      DateTime @updatedAt

  @@index([key])
}

// ----------------------------------------------------
// MULTI-SOURCE THREAT ACTOR DISCOVERY & LINEAGE
// ----------------------------------------------------

model IntelligenceSource {
  id            String                  @id // "RANSOMWARE_LIVE", "ISMALICIOUS", "RANSOMWATCH"
  name          String
  sourceType    String                  // "LIVE_PRIMARY", "DERIVED_OR_MIRRORED", "HISTORICAL_ARCHIVE"
  lineage       SourceLineage           @default(PRIMARY_INDEPENDENT)
  isEnabled     Boolean                 @default(true)
  lastSyncAt    DateTime?
  lastSyncStatus SyncStatus?
  lastError     String?                 @db.Text
  recordsTotal  Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  observations  GroupSourceObservation[]
}

model GroupSourceObservation {
  id               String              @id @default(uuid())
  groupId          String
  sourceId         String
  sourceGroupName  String
  externalRecordId String?
  firstClaimAt     DateTime?
  sourceAddedAt    DateTime?
  sourceUpdatedAt  DateTime?
  observedAt       DateTime            @default(now())
  confidenceScore  Float?              @default(1.0)
  semantic         ObservationSemantic @default(THREATLEDGER_OBSERVED)
  rawPayload       Json?
  createdAt        DateTime            @default(now())

  group            RansomwareGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  source           IntelligenceSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([groupId, observedAt])
  @@index([sourceId, observedAt])
  @@index([firstClaimAt])
}

model GroupVerification {
  id             String          @id @default(uuid())
  groupId        String
  verifiedById   String
  action         String          // VERIFY_DISTINCT, REJECT_FALSE, LINK_ALIAS, REBRAND_REVIEW
  previousStatus String?
  newStatus      String
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())

  group          RansomwareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  verifiedBy     UserProfile     @relation(fields: [verifiedById], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model HistoricalImportRun {
  id                String      @id @default(uuid())
  sourceId          String      @default("RANSOMWATCH")
  repositoryUrl     String
  commitSha         String?
  contentHash       String?
  recordsRead       Int         @default(0)
  recordsImported   Int         @default(0)
  recordsSkipped    Int         @default(0)
  recordsMatched    Int         @default(0)
  dateCoverageStart DateTime?
  dateCoverageEnd   DateTime?
  status            SyncStatus  @default(SUCCESS)
  startedAt         DateTime    @default(now())
  completedAt       DateTime?
  error             String?     @db.Text

  @@index([sourceId, startedAt])
}

model SourceCredential {
  id                    String    @id @default(uuid())
  sourceId              String    @unique // "ISMALICIOUS"
  encryptedApiKey       String    @db.Text
  encryptedApiSecret    String    @db.Text
  iv                    String
  tag                   String
  isEnabled             Boolean   @default(true)
  lastTestStatus        String?
  lastTestedAt          DateTime?
  lastError             String?   @db.Text
  requestsUsedThisMonth Int       @default(0)
  monthlyQuota          Int       @default(250)
  lastSyncAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([sourceId])
}
